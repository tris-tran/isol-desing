    "pairings": "Recommended text-on-ground combinations, with WCAG 2.x contrast ratios computed from the palette values.",
    "schemes": "Ready-made combinations. Each gives a colour to every role: ground, field, motif, accent, line and ink. Use them for avatars, cards, banners and illustrations.",
    "contrastGrades": {
      "AAA": ">= 7",
      "AA": ">= 4.5",
      "AA large": ">= 3",
      "Decorative": "< 3"
    }
  },
