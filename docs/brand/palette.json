  "layout": {
    "rule": "1.5px solid var(--rule)",
    "softRule": "1px solid color-4",
    "frame": {
      "note": "Beardsley-style triple-rule frame",
      "maxWidth": "1080px",
      "css": {
        "border": "1.5px solid var(--rule)",
        "outline": "1.5px solid var(--rule)",
        "outlineOffset": "5px",
        "boxShadow": "0 0 0 11px var(--paper), 0 0 0 12.5px var(--rule)"
      }
    },
