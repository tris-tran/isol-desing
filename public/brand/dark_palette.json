  "source": {
    "title": "Isolde",
    "artist": "Aubrey Beardsley",
    "medium": "colour lithograph",
    "printer": "W. Griggs",
    "image": "2010.651_print.jpg",
    "description": "The night counterpart of the Isolde palette. The grounds are drawn from Aubergine, the darkest ink in the print; the papers become the writing; accents keep their hue and are lifted a step where needed to read on night."
  },
  "notes": {
    "palette": "Fourteen colours in three families. The grounds are new, drawn from Aubergine. The papers become the writing. The accents keep their hue; where one was too dark to read on night, it is lifted a step.",
    "derived": "derived: true marks colours that aren't in palette.json; from says what they come from. Colours with derived: false are the day colours, reused as they are.",
    "weights": "weight is the relative share of a colour in a typical night composition (sums to 100; used for the proportion strip).",
    "labelOn": "Token to use for text placed directly on this colour (whichever of color-1 / night-1 contrasts more).",
    "fromDay": "fromDay maps each of the 15 day colours (palette.json) to the night colour that does the same job.",
    "pairings": "Recommended text-on-ground combinations for night, with WCAG 2.x contrast ratios computed from the palette values.",
    "schemes": "Illustration schemes are the same as in palette.json: pictures keep their own colours at night; only the page around them changes.",
    "contrastGrades": {
      "AAA": ">= 7",
      "AA": ">= 4.5",
      "AA large": ">= 3",
      "Decorative": "< 3"
    }
  },
