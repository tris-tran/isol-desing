    "frame": {
      "note": "Beardsley-style triple-rule frame, in Rule on Night",
      "maxWidth": "1080px",
      "css": {
        "border": "1.5px solid var(--rule)",
        "outline": "1.5px solid var(--rule)",
        "outlineOffset": "5px",
        "boxShadow": "0 0 0 11px var(--paper), 0 0 0 12.5px var(--rule)"
      }
    },
    "heroCurtainLines": {
